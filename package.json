{
  "name": "hedge-lbank",
  "version": "0.1.20",
  "description": "Premium cross-exchange futures hedge terminal for Windows and macOS",
  "author": "Hedge LBank",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"next dev -H 127.0.0.1\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "dev:web": "next dev -H 127.0.0.1",
    "dev:desktop": "wait-on http://127.0.0.1:3000 && electron .",
    "dev:import-profile": "node scripts/import-desktop-profile.cjs",
    "build:web": "next build",
    "build": "npm run build:web && electron-builder",
    "build:win": "npm run build:web && electron-builder --win",
    "build:mac": "npm run build:web && electron-builder --mac",
    "scan:liquidity": "node scripts/liquidity-lag-scanner.cjs --duration-hours 1",
    "paper:all-coins": "node scripts/lbank-all-coins-paper.cjs --duration-hours 1",
    "impulse": "python tools/lbank-impulse/lbank_impulse.py",
    "test:impulse": "node --test tools/lbank-impulse/*.test.cjs scripts/liquidity-lag-scanner.test.cjs scripts/lbank-all-coins-paper.test.cjs electron/trading/live-trading-lock.test.cjs && python -m unittest discover -s tools/lbank-impulse -p test_ui.py",
    "typecheck": "tsc --noEmit",
    "test:backend": "node --test electron/*.test.cjs electron/exchanges/*.test.cjs electron/trading/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "https-proxy-agent": "^9.1.0",
    "socks-proxy-agent": "^10.1.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "electron": "44.4.5",
    "electron-builder": "^26.0.12",
    "motion": "^12.23.12",
    "next": "^16.3.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "^5.9.2",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.hedgelbank.desktop",
    "productName": "Hedge LBank",
    "files": [
      "out/**/*",
      "electron/**/*",
      "!electron/**/*.test.cjs",
      "!electron/**/fixtures.cjs",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "public/app-icon.png",
      "target": "nsis"
    },
    "mac": {
      "icon": "public/app-icon.png",
      "target": "dmg",
      "category": "public.app-category.finance"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://updates.invalid/hedge-lbank"
      }
    ]
  }
}
